# Dokploy → сервис cms → Environment. Полное описание — в .env.example и README.

# PostgreSQL: Internal Host из карточки БД
DATABASE_URL=postgresql://postgres:CHANGE_ME@<internal-host-БД>:5432/movhub
PAYLOAD_SECRET=            # openssl rand -hex 32; после запуска НЕ менять (разлогинит всех)

CMS_URL=https://cms.otakuum.ru
FRONTEND_URL=https://otakuum.ru,https://www.otakuum.ru
# CMS и сайт — поддомены одного домена: без этого cookie входа не видна сайту
COOKIE_DOMAIN=.otakuum.ru

# MinIO (отдельный сервис Dokploy)
S3_BUCKET=media
S3_ENDPOINT=http://<internal-host-minio>:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://s3.otakuum.ru/media

# Сброс кэша сайта после правок. Секрет — тот же, что в окружении web.
REVALIDATE_URL=http://movhub-web:3000
REVALIDATE_SECRET=

# Почта и форма обратной связи
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@otakuum.ru
EMAIL_FROM_NAME=MovHub
CONTACT_EMAIL_TO=

# 1 = Traefik, 2 = Cloudflare → Traefik
TRUSTED_PROXY_HOPS=1
