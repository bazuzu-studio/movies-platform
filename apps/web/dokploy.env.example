# Dokploy → сервис web → Environment.
# NEXT_PUBLIC_* и S3_* вшиваются в образ при сборке: после их смены нужен Rebuild, а не Restart.

NEXT_PUBLIC_SITE_URL=https://otakuum.ru
NEXT_PUBLIC_GRAPHQL_API_URL=https://cms.otakuum.ru/api/graphql

# Публичный адрес файлов MinIO (бакет с именем в конце) — для next/image
S3_PUBLIC_URL=https://s3.otakuum.ru/media
# S3_INTERNAL_URL=            # необязательно, обычно не нужен

# Серверные (SSR) запросы к CMS внутри dokploy-network — быстрее, без выхода в интернет.
# Раскомментируйте, когда CMS уже работает с alias movhub-cms.
# GRAPHQL_API_URL=http://movhub-cms:3000/api/graphql

# Общий секрет с CMS (openssl rand -hex 32). Тот же REVALIDATE_SECRET — в окружении CMS.
REVALIDATE_SECRET=
